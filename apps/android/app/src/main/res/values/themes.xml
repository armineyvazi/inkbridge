<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light, flat, no animations: what reads well and refreshes fast on e-ink. -->
    <style name="Theme.InkBridge" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorAccent">#000000</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <!-- Pure black text and a black caret/selection: greys dither on e-ink. -->
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#404040</item>
        <item name="android:textColorHint">#707070</item>
        <item name="android:colorControlActivated">#000000</item>
        <item name="android:colorControlNormal">#000000</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
