<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TCP/TLS to the Mac (Wi-Fi, and USB via adb reverse). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Network-change callbacks, for reconnecting right after Wi-Fi returns. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Bonjour (NSD) discovery: the multicast lock keeps mDNS answers from being filtered. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- allowBackup=false: the device token must not leave the tablet in a backup. -->
    <application
        android:name=".InkBridgeApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_inkbridge"
        android:label="InkBridge"
        android:supportsRtl="true"
        android:theme="@style/Theme.InkBridge">

        <activity
            android:name=".features.dashboard.DashboardActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- inkbridge://pair?… from the Mac's Connect Device QR code. -->
        <activity
            android:name=".features.connect.ConnectActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="inkbridge" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- configChanges: rotation resizes the surface instead of recreating the
             activity, so the stroke in progress survives. -->
        <activity
            android:name=".features.canvas.CanvasActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing" />

        <activity android:name=".features.settings.SettingsActivity" android:exported="false" />
        <activity android:name=".features.diagnostics.DiagnosticsActivity" android:exported="false" />
    </application>
</manifest>
